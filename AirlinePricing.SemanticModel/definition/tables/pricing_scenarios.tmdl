	partition pricing_scenarios = m
		mode: import
		source =
				let
					Source = Csv.Document(File.Contents("C:\airline-pricing-analysis\data\pricing_scenarios.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
					Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
					Typed = Table.TransformColumnTypes(Headers, {{"flight_id", type text}, {"route", type text}, {"days_to_departure", Int64.Type}, {"seats_remaining", Int64.Type}, {"price_change_pct", type number}, {"demand_change_pct", type number}, {"assumed_future_fare_eur", type number}, {"baseline_unconstrained_demand", type number}, {"expected_additional_passengers", type number}, {"capacity_constrained", type logical}, {"future_sales_revenue_eur", type number}, {"baseline_future_revenue_eur", type number}, {"revenue_change_eur", type number}, {"scenario_total_booked_revenue_eur", type number}, {"is_synthetic", type logical}}, "en-US")
				in Typed

