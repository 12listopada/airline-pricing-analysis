table pricing_scenarios
	lineageTag: bc2f2661-a9ae-4f1d-8f1e-cd15e67704e2

	measure 'Future Revenue EUR' = IF(HASONEVALUE(current_vs_history[flight_id]), SUM(pricing_scenarios[future_sales_revenue_eur]))
		formatString: #,0.00
		lineageTag: 7ed4993b-4cc6-4cd7-802e-e67ea93655c2

	measure 'Revenue Change EUR' = IF(HASONEVALUE(current_vs_history[flight_id]), SUM(pricing_scenarios[revenue_change_eur]))
		formatString: #,0.00
		lineageTag: fbdc60b9-511f-4821-a010-9a724b97b22d

