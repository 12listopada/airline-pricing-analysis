              {
                "textRuns": [
                  {
                    "value": "Portfolio case study using simulated airline booking and fare data.",
                    "textStyle": {
                      "fontSize": "20pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Analysis date: October 2026. All monetary values are in EUR.",
                    "textStyle": {
                      "fontSize": "20pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Three illustrative routes, 54 future flights and 33 historical comparison flights per route.",
                    "textStyle": {
                      "fontSize": "20pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": ""
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Historical benchmarks match each flight’s route and days before departure.",
                    "textStyle": {
                      "fontSize": "20pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Flights with zero bookings remain in the benchmark. Future checkpoints are excluded.",
                    "textStyle": {
                      "fontSize": "20pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "The portfolio booking gap is weighted by seat capacity and is a descriptive performance indicator.",
                    "textStyle": {
                      "fontSize": "20pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": ""
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Booking gaps below −5 pp or above +5 pp are highlighted using illustrative review thresholds, not validated pricing rules.",
                    "textStyle": {
                      "fontSize": "20pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": ""
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "The model excludes cancellations, group bookings, overbooking, connections and fare restrictions.",
                    "textStyle": {
                      "fontSize": "20pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Seasonality, weekday patterns and competitor offers are not controlled for.",
                    "textStyle": {
                      "fontSize": "20pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Booked revenue represents cumulative ticket sales, not recognized revenue or profit.",
                    "textStyle": {
                      "fontSize": "20pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": ""
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Demand levels and late-booking fare patterns are assumptions built into the data generator.",
                    "textStyle": {
                      "fontSize": "20pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Pricing scenarios vary price and demand independently, with additional sales capped at remaining capacity.",
                    "textStyle": {
                      "fontSize": "20pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Scenarios do not estimate causal price elasticity or identify an optimal fare.",
                    "textStyle": {
                      "fontSize": "20pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Operational pricing decisions would require further market, demand and fare-product evidence.",
                    "textStyle": {
                      "fontSize": "20pt"
                    }
                  }
                ]
              }
            ]
          }
        }
      ]
