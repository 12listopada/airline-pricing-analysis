          "properties": {
            "paragraphs": [
              {
                "textRuns": [
                  {
                    "value": "Baseline: historical remaining booking pickup at the same lead time; fare = route base fare × 1.45.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "15pt",
                      "color": "#536579"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Price and demand vary independently. Sales are capped at available seats; existing sales stay fixed.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "15pt",
                      "color": "#536579"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Break-even without a capacity cap: −10% price needs +11.11% sales; +10% price tolerates −9.09% sales.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "15pt",
                      "color": "#536579"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "At D−1, remaining demand is zero because the generator excludes departure-day bookings.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "15pt",
                      "color": "#536579"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Scenarios are sensitivity assumptions, not elasticity estimates or optimal-fare recommendations.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "15pt",
                      "color": "#536579"
                    }
                  }
                ]
              }
            ]
          }
        }
      ]
